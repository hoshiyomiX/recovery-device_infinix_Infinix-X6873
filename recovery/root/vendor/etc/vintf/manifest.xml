<?xml version="1.0" encoding="utf-8"?>
<!--
    VINTF Manifest for Infinix X6873 Recovery
    Platform: MT6897 (Dimensity 8350)
    TEE: Trustonic Kinibi with Keymint 3.0 (AIDL)

    NOTE: This main manifest only declares HALs that are NOT in fragment
    files under vendor/etc/vintf/manifest/. Fragment-declared HALs
    (keymint, gatekeeper, secureclock, sharedsecret, health, boot,
    paytrigger) must NOT be re-declared here — doing so causes VINTF
    verification failures due to duplicate instance declarations.

    Trustonic TEE/TUI are declared as HIDL (not AIDL) because the X6873
    firmware ships HIDL 1.1/1.0 binaries (vendor.trustonic.tee@1.1-service
    and vendor.trustonic.tee.tui@1.0.so). The X6728 template declares these
    as AIDL, but that is vestigial — X6728 does not ship the binaries.
-->
<manifest version="8.0" type="device" target-level="8">
    <!-- Trustonic TEE (HIDL 1.1 — binary: vendor.trustonic.tee@1.1-service) -->
    <hal format="hidl">
        <name>vendor.trustonic.tee</name>
        <transport>hwbinder</transport>
        <version>1.1</version>
        <interface>
            <name>ITee</name>
            <instance>default</instance>
        </interface>
        <fqname>@1.1::ITee/default</fqname>
    </hal>

    <!-- Trustonic TUI (HIDL 1.0 — lib: vendor.trustonic.tee.tui@1.0.so) -->
    <hal format="hidl">
        <name>vendor.trustonic.tee.tui</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>ITui</name>
            <instance>default</instance>
        </interface>
        <fqname>@1.0::ITui/default</fqname>
    </hal>

    <sepolicy>
        <version>35.0</version>
    </sepolicy>
    <kernel target-level="8"/>
</manifest>
