# Recovery init for Infinix X6873 (MT6897)
# Keymint 3.0 + Gatekeeper AIDL + Trustonic TEE
# Adapted from tecno_LH8n-TWRP reference

import /init.cgroup.rc
import /init.tee.rc

on init
    setprop sys.usb.configfs 1
    setprop sys.usb.controller "musb-hdrc"
    setprop sys.usb.ffs.aio_compat 1
    export LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw
    symlink /system/etc/ /etc/
    setprop crypto.ready 1
    setprop ro.board.api_level 202404
    start boot-hal-1-2

    # Set hardware properties for crypto HALs
    setprop ro.hardware.gatekeeper trustonic
    setprop ro.hardware.keymaster trustonic
    setprop ro.hardware.keystore_keymint trustonic

on fs
    write /proc/bootprof "INIT:fs"
    install_keyring
    wait /dev/block/platform/soc/11270000.ufshci
    symlink /dev/block/platform/soc/11270000.ufshci /dev/block/bootdevice
    start adbd

# We need vold early for metadata encryption
on early-fs
    start vold

on late-fs
    # Mount RW partitions which need run fsck
    mount_all /first_stage_ramdisk/fstab.mt6897 --late

on post-fs
    # Run mtk_plpath_utils before symlinks (per fox_14.1 template pattern)
    exec u:r:update_engine:s0 root root -- /system/bin/mtk_plpath_utils
    start mtk.plpath.utils.link

    # Create necessary directories
    mkdir /mnt/vendor/persist 0771 system system
    
    # Mount persist partition
    mount ext4 /dev/block/by-name/persist /mnt/vendor/persist rw

    # Create TEE directories
    mkdir /mnt/vendor/persist/mcRegistry 0771 system system
    mkdir /mnt/vendor/persist/keybox 0771 system system

    # Set permissions for TEE devices
    chmod 0660 /dev/tee0
    chmod 0660 /dev/teepriv0
    chown system system /dev/tee0
    chown system system /dev/teepriv0

    # RPMB device permissions
    chmod 0660 /dev/rpmb0
    chmod 0660 /dev/mmcblk0rpmb
    chown system system /dev/rpmb0
    chown system system /dev/mmcblk0rpmb

    symlink /dev/block/mapper/pl_a /dev/block/by-name/preloader_raw_a
    symlink /dev/block/mapper/pl_b /dev/block/by-name/preloader_raw_b

on boot
    start mtk.plpath.utils.link

on property:persist.vendor.mtk.pl_lnk=1
    symlink /dev/block/mapper/pl_a /dev/block/by-name/preloader_raw_a
    symlink /dev/block/mapper/pl_b /dev/block/by-name/preloader_raw_b
    symlink /dev/block/mapper/pl_a /dev/block/platform/bootdevice/by-name/preloader_raw_a
    symlink /dev/block/mapper/pl_b /dev/block/platform/bootdevice/by-name/preloader_raw_b

# FSTAB_RAW2(lk2,bootloader2) of fstab.in.emmc, but without bootloader2 mount point
    symlink /dev/block/by-name/lk1 /dev/block/by-name/bootloader1
    symlink /dev/block/by-name/lk2 /dev/block/by-name/bootloader2

# Fix ro.vendor.mtk_ufs_support remove issue of recovery mode
on property:vendor.mtk.boot0_linka=1
    symlink /dev/block/sda /dev/block/mmcblk0boot0

on property:vendor.mtk.boot0_linkb=1
    symlink /dev/block/sdb /dev/block/mmcblk0boot0

on property:vendor.mtk.boot0_linkc=1
    symlink /dev/block/sdc /dev/block/mmcblk0boot0

on property:vendor.mtk.boot1_linka=1
    symlink /dev/block/sda /dev/block/mmcblk0boot1

on property:vendor.mtk.boot1_linkb=1
    symlink /dev/block/sdb /dev/block/mmcblk0boot1

on property:vendor.mtk.boot1_linkc=1
    symlink /dev/block/sdc /dev/block/mmcblk0boot1

service mtk.plpath.utils.link /system/bin/mtk_plpath_utils
    class main
    user root
    group root system
    oneshot
    disabled
    seclabel u:r:recovery:s0

# Gatekeeper Service (AIDL V1) — declared inline per X6728 template pattern.
# The vendor/etc/init/android.hardware.gatekeeper-service.trustonic.rc file was
# removed (it declared the same binary under a different service name
# 'vendor.gatekeeper-default' with user=system and no seclabel, conflicting
# with this inline declaration). X6728 keeps all Trustonic HAL services inline.
service gatekeeper-1-0 /vendor/bin/hw/android.hardware.gatekeeper-service.trustonic
    interface android.hardware.gatekeeper-V1::IGatekeeper default
    user root
    group root
    disabled
    seclabel u:r:recovery:s0

# Keymint Service (AIDL 3.0) — declared inline per X6728 template pattern.
# The vendor/etc/init/android.hardware.security.keymint@3.0-service.trustonic.rc
# file was removed (same conflict reason as gatekeeper above).
# Note: user=root required for TEE communication (was 'nobody' before — caused
# KeyMint service to fail talking to mcDriverDaemon). X6728 uses root for all
# Trustonic HAL services.
service keymint-3-0 /vendor/bin/hw/android.hardware.security.keymint@3.0-service.trustonic
    class early_hal
    interface android.hardware.security.keymint-V3::IKeymintDevice default
    interface android.hardware.security.secureclock-V1::ISecureClock default
    interface android.hardware.security.sharedsecret-V1::ISharedSecret default
    user root
    group root
    seclabel u:r:recovery:s0

# Trustonic TEE 1.1 service is declared in
# vendor/etc/init/vendor.trustonic.tee@1.1-service.rc (auto-loaded by init).
# No duplicate inline declaration here.

# Start mobicore on encrypted dynamic-partitions devices.
# This trigger matches fox_14.1 template pattern (init.recovery.mt6768.rc line 73-74).
# Port also has 2 additional mobicore triggers below (hwservicemanager.ready + post-fs-data)
# which provide redundancy — init deduplicates multiple start requests.
on property:ro.crypto.state=encrypted && property:ro.boot.dynamic_partitions=true
    start mobicore

# Priority 2 fix: align with X6728 pattern — start gatekeeper/keymint only
# after Trustonic TEE (mobicore) is ready, not on crypto.ready (which fires
# too early, before mobicore is running).
on property:ro.vendor.trustonic.ready=true
    start gatekeeper-1-0
    start keymint-3-0
    start tee-1-1

on property:hwservicemanager.ready=true
    start mobicore
    start gatekeeper-1-0
    start keymint-3-0
    start tee-1-1

on property:ro.crypto.state=unsupported
    stop mobicore
    stop gatekeeper-1-0
    stop keymint-3-0

on property:ro.crypto.state=unencrypted
    stop mobicore
    stop gatekeeper-1-0
    stop keymint-3-0

on property:twrp.decrypt.done=true
    stop mobicore
    stop gatekeeper-1-0
    stop keymint-3-0

on property:crypto.ready=0
    stop mobicore
    stop gatekeeper-1-0
    stop keymint-3-0

# Keystore2 Service (AIDL) — declared inline per fox_14.1 template pattern.
# Without this declaration, keystore2 may not start properly in recovery,
# breaking FBE decryption (keystore2 is the gateway between TWRP and keymint).
service keystore2 /system/bin/keystore2 /tmp/misc/keystore
    class early_hal
    interface aidl android.system.keystore2.IKeystoreService/default
    user root
    group root keystore readproc log
    writepid /dev/cpuset/foreground/tasks
    seclabel u:r:recovery:s0
    override

# Health HAL (AIDL — service declared inline here per X6728 template pattern.
service vendor.health-default /system/bin/hw/android.hardware.health-service.example_recovery
    class hal
    user root
    group root
    capabilities WAKE_ALARM BLOCK_SUSPEND
    file /dev/kmsg w
    seclabel u:r:recovery:s0
    override

on post-fs-data
    mkdir /data/vendor_de 0770 system system
    mkdir /data/vendor_de/0 0770 system system
    mkdir /data/vendor_de/0/cryptoeng 0770 system system

    # Start TEE daemon
    start mobicore

    # Start Health HAL (now declared above)
    start vendor.health-default
    setprop sys.usb.config adb

# Set boot_completed when servicemanager is ready (per fox_14.1 template)
on property:servicemanager.ready=true
    setprop sys.boot_completed 1
